        <mxCell id="iam_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontSize=11;align=left;strokeColor=#232F3E;fillColor=#FFFDE7;spacingLeft=8;spacingRight=8;spacingTop=8;fontColor=#333333;" value="&lt;b&gt;IAM Policies (not network topology):&lt;/b&gt;&lt;br&gt;• API GW Role → SQS:SendMessage (this queue only)&lt;br&gt;• Batch Role → SQS:ReceiveMessage + DeleteMessage&lt;br&gt;• Batch Role → S3:GetObject (data bucket)&lt;br&gt;• Batch Role → S3:PutObject (results bucket)&lt;br&gt;• Lambda Role → S3:GetObject (results bucket)" vertex="1">
